# Copiá este archivo como .env y completá tus datos.

# Dirección pública del servidor (la que ven tus clientes en los links).
# En local dejala así; al deployar poné tu dominio, ej.: https://calco.tuagencia.com
BASE_URL=http://localhost:3000
PORT=3000

# Envío real por Gmail. Necesitás una "contraseña de aplicación":
# 1) Activá la verificación en dos pasos en tu cuenta de Google
# 2) Entrá a https://myaccount.google.com/apppasswords
# 3) Generá una contraseña para "Correo" y pegala acá (16 letras, sin espacios)
# Si dejás esto vacío, el envío se simula y el agente descarga el PDF desde su panel.
GMAIL_USER=
GMAIL_APP_PASSWORD=
